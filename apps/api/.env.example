ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://opero:opero@localhost:5432/opero
REDIS_URL=redis://localhost:6379/0

# Local email/password session auth (docs/SECURITY_MODEL.md §3).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SIGNING_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_STATE_SECRET=

# OIDC — a future SSO login path (app/core/oidc.py), not wired into any route yet.
AUTH_ISSUER=https://your-tenant.auth0.com/
AUTH_AUDIENCE=https://api.opero.ai

# AI provider — Ollama (docs/AI_ARCHITECTURE.md §3). Swapping the model or the
# runtime entirely (e.g. to vLLM) is a config change here, not a code change.
OLLAMA_BASE_URL=http://localhost:11434
MODEL_REASONING_NAME=qwen2.5:7b-instruct
MODEL_EMBEDDING_NAME=nomic-embed-text

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=opero-api

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3010

RATE_LIMIT_PER_MINUTE=120

# Gmail OAuth (docs/MVP_SCOPE.md, MVP feature 1) — create an OAuth client in
# Google Cloud Console (APIs & Services > Credentials) with this redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback

# Document storage (docs/KNOWLEDGE_SYSTEM.md) — MinIO, matches infra/docker-compose.yml.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=opero
MINIO_SECRET_KEY=opero-dev-secret
MINIO_BUCKET=opero-documents
MINIO_SECURE=false

MAX_DOCUMENT_SIZE_BYTES=26214400
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
MIN_CHUNK_LENGTH_CHARS=50

RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5
